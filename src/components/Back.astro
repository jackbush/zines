---
// The back button, at the left of the top bar (TopBar.astro): a square filled .btn, like the bar's other controls. It goes to `href` (the library by default). A page that
// can be the first stop from jackbush.github.io passes `home`: with ?from=home the button goes
// there instead. Any other page keeps ?from=home on its link so the library still knows.
import { url } from '../lib/site';

interface Props {
  href?: string;
  label?: string;
  /** Start hidden; only shown for visitors from jackbush.github.io (needs `home`). */
  hidden?: boolean;
  /** This page's back button goes to jackbush.github.io when the URL has ?from=home. */
  home?: boolean;
}

const { href = url(), label = 'All zines', hidden = false, home = false } = Astro.props;
---

<a id="back" class="btn btn-fill back" href={href} aria-label={label} hidden={hidden} data-home={home ? '' : null}>
  <svg viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M224,128a8,8,0,0,1-8,8H59.31l58.35,58.34a8,8,0,0,1-11.32,11.32l-72-72a8,8,0,0,1,0-11.32l72-72a8,8,0,0,1,11.32,11.32L59.31,120H216A8,8,0,0,1,224,128Z" /></svg>
</a>
<script is:inline>
  // ?from=home: back goes to jackbush.github.io where the page allows it, else the link keeps the flag.
  if (new URLSearchParams(location.search).get('from') === 'home') {
    const back = document.getElementById('back');
    if (back.hasAttribute('data-home')) {
      back.href = '/';
      back.setAttribute('aria-label', 'Back to homepage');
      back.hidden = false;
    } else {
      const next = new URL(back.href);
      next.searchParams.set('from', 'home');
      back.href = next.href;
    }
  }
</script>

<style is:global>
  .back { grid-column: 1; justify-self: start; width: 32px; padding: 0; justify-content: center; }
  .back[hidden] { display: none; }
  .back svg { width: 16px; height: 16px; display: block; }
</style>
