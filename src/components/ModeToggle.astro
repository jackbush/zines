---
// /preview's Flat / Scroll / Flick switch, on the right of the top bar. src/lib/views.ts's bindToggle drives it.
import { MODES } from '../lib/views';

interface Props {
  hidden?: boolean;
}

const { hidden = false } = Astro.props;
const names = { flick: 'Flick', scroll: 'Scroll', flat: 'Flat' };
---

<div class="toggle" id="toggle" role="group" aria-label="View" hidden={hidden}>
  {MODES.map((mode) => <button class="btn" type="button" data-mode={mode} aria-pressed="false">{names[mode]}</button>)}
</div>

<style>
  /* The buttons are BaseLayout's .btn, joined into one strip with rounded outer corners. */
  .toggle { display: flex; flex: none; }
  .toggle[hidden] { display: none; }
  .btn + .btn { margin-left: -1px; }
  .btn:not(:first-child) { border-top-left-radius: 0; border-bottom-left-radius: 0; }
  .btn:not(:last-child) { border-top-right-radius: 0; border-bottom-right-radius: 0; }
  /* The chosen view looks like .btn-fill. */
  .btn[aria-pressed='true'] { background: var(--ink); color: var(--paper); }
</style>
