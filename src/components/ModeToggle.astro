---
// The Flick / Scroll / Flat switch on the right of the top bar. src/lib/views.ts's bindToggle drives it.
import { MODES } from '../lib/views';

interface Props {
  hidden?: boolean;
}

const { hidden = false } = Astro.props;
const names = { flick: 'Flick', scroll: 'Scroll', flat: 'Flat' };
---

<div class="toggle" id="toggle" role="group" aria-label="View" hidden={hidden}>
  {MODES.map((mode) => <button type="button" data-mode={mode} aria-pressed="false">{names[mode]}</button>)}
</div>

<style>
  .toggle { display: flex; flex: none; }
  .toggle[hidden] { display: none; }
  button {
    height: 32px; padding: 0 10px; display: inline-flex; align-items: center;
    border: 1px solid var(--line); background: #fff; color: var(--ink); font: inherit; font-size: 14px; cursor: pointer;
  }
  button + button { margin-left: -1px; }
  button:hover { background: var(--ink); color: #fff; }
  button[aria-pressed='true'] { background: var(--ink); color: #fff; }
  button:focus-visible { position: relative; outline: 2px solid var(--line); outline-offset: 2px; }
  @media (max-width: 599px) { button { padding: 0 7px; font-size: 13px; } }
</style>
