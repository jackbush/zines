---
// The flick viewer for a built zine; it fills its parent. /preview makes its own with createFlick.
import type { Page } from '../lib/sheet';

interface Props {
  pages: Record<Page, string>;
  /** Accessible name for the viewer, e.g. the zine's name. */
  label: string;
}

const { pages, label } = Astro.props;
---

<div class="flick-root" role="region" aria-label={label} data-pages={JSON.stringify(pages)}></div>

<script>
  import { createFlick } from '../lib/flick';
  for (const el of document.querySelectorAll<HTMLElement>('.flick-root[data-pages]')) createFlick(el, JSON.parse(el.dataset.pages!));
</script>

<style>
  .flick-root { width: 100%; height: 100%; }
</style>
