---
// The library: every zine on a shelf, then the preview "zine" after the last one.
import BaseLayout from '../layouts/BaseLayout.astro';
import TopBar from '../components/TopBar.astro';
import { PAGE_ASPECT } from '../lib/sheet';
import { url } from '../lib/site';
import { getZines } from '../lib/zines';

const zines = getZines();
// A thumb's intrinsic size, for its aspect ratio so the layout doesn't jump; CSS sets the real width.
const THUMB_W = 220;
const THUMB_H = Math.round(THUMB_W / PAGE_ASPECT);
// Shelf sizing. A shelf holds as many covers as fit at MIN_COVER (up to PER_ROW_MAX), then
// scales them up to fill the width, stopping when a cover reaches MAX_HEIGHT of the window.
// GUTTER is the gap between covers; half of it is left on the shelf past the outer ones.
const PER_ROW_MAX = 3;
const MIN_COVER = 220;
const GUTTER = 32;
const MAX_HEIGHT = 2 / 3;
// Media queries can't read custom properties, so the per-row breakpoints are written out here.
const perRow = Array.from({ length: PER_ROW_MAX - 1 }, (_, i) => i + 2)
  .map((n) => `@container library (min-width: ${n * (MIN_COVER + GUTTER)}px) { .shelves { --per-row: ${n}; } }`)
  .join('\n');
// The first row is in view on load; the rest load lazily.
const EAGER = PER_ROW_MAX;
---

<BaseLayout title="Zines">
  <Fragment set:html={`<style>${perRow}</style>`} />
  <TopBar home backHidden>Zines</TopBar>
  <main>
    <!-- Every cover draws a shelf line wider than the shelf, and the shelf clips it at its padding,
         so each row gets one unbroken line, a short last row included, with no JS. The preview
         "zine" is the last item, wherever it falls. -->
    <ul class="shelves" style={`--aspect:${PAGE_ASPECT};--gutter:${GUTTER}px;--max-h:${MAX_HEIGHT * 100}dvh`}>
      {zines.map((zine, i) => (
        <li>
          <a href={url(zine.slug + '/')} data-zine>
            <span class="cover"><img src={zine.thumb} alt="" width={THUMB_W} height={THUMB_H} loading={i < EAGER ? 'eager' : 'lazy'} /></span>
            <span class="name">{zine.name}</span>
          </a>
        </li>
      ))}
      <li>
        <a href={url('preview/')} data-zine>
          <span class="cover"><span class="placeholder">Preview</span></span>
          <span class="name">Preview</span>
        </a>
      </li>
    </ul>
  </main>
</BaseLayout>

<script is:inline>
  // ?from=home: zine links carry it so the zine's back button returns here with the flag.
  if (new URLSearchParams(location.search).get('from') === 'home') {
    for (const a of document.querySelectorAll('a[data-zine]')) {
      const next = new URL(a.href);
      next.searchParams.set('from', 'home');
      a.href = next.href;
    }
  }
</script>

<style>
  /* --per-row starts here so the breakpoints above, on .shelves, override it. */
  main { container: library / inline-size; --per-row: 1; padding: 32px 16px max(32px, env(safe-area-inset-bottom)); }
  .shelves {
    /* Each cover's share of the width less a gutter, until it's as tall as the window allows. */
    --cover: min(100cqw / var(--per-row) - var(--gutter), var(--max-h) * var(--aspect));
    /* Exactly wide enough for a full row: covers, gaps and a half-gutter at each end. */
    width: calc(var(--per-row) * (var(--cover) + var(--gutter)));
    list-style: none; margin: 0 auto; padding: 0 calc(var(--gutter) / 2);
    display: flex; flex-wrap: wrap; justify-content: center; column-gap: var(--gutter); row-gap: 48px;
    overflow-x: clip;
  }
  li { width: var(--cover); }
  a { display: block; color: var(--ink); text-decoration: none; }
  .cover { position: relative; display: block; }
  /* The shelf: 200vw wide, centred on the cover, so a row's lines merge and the shelf trims them. */
  .cover::after {
    content: ''; position: absolute; top: 100%; left: 50%; width: 200vw; height: 6px;
    transform: translateX(-50%); background: var(--line); pointer-events: none;
  }
  img, .placeholder { display: block; width: 100%; height: auto; border: 1px solid var(--line); background: #fff; transition: transform 0.12s; }
  .placeholder { aspect-ratio: var(--aspect); display: grid; place-items: center; border-style: dashed; color: var(--ink-dim); }
  .name { display: block; margin-top: 14px; font-size: 14px; text-align: center; }
  a:hover img, a:hover .placeholder { transform: translateY(-3px); }
  a:focus-visible { outline: none; }
  a:focus-visible img, a:focus-visible .placeholder { outline: 2px solid var(--line); outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) { img, .placeholder { transition: none; } }
</style>
