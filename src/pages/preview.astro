---
// A private check of a sheet before it's published: pick or drop a PNG and read it as the flat
// sheet, a scroll or a flick. It opens on a sample sheet, flat. It's sliced in the browser with the
// same map as the build, and keeps nothing: no storage, no upload, and every load starts afresh.
import BaseLayout from '../layouts/BaseLayout.astro';
import ModeToggle from '../components/ModeToggle.astro';
import TopBar from '../components/TopBar.astro';
import { site } from '../lib/site';
---

<BaseLayout title={`Preview | ${site.name}`}>
  <meta name="robots" content="noindex" slot="head" />
  <main>
    <TopBar centred={false}>
      <span class="title">
        <span class="name" id="name">Preview</span>
        <button class="update" id="update" type="button" hidden>(update)</button>
      </span>
      <ModeToggle slot="actions" hidden />
    </TopBar>
    <input id="file" type="file" accept="image/png" hidden />
    <div class="stage" id="stage">
      <p class="note" id="note" role="status" hidden></p>
    </div>
  </main>
  <div class="drop" id="drop" aria-hidden="true" hidden>Drop to preview</div>
</BaseLayout>

<script>
  import { isSheetShaped } from '../lib/sheet';
  import { slice, type Sheet } from '../lib/slice';
  import { bindToggle, createView, type Mode } from '../lib/views';
  import sample from '../assets/preview-sample.png?url';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const input = $<HTMLInputElement>('file');
  const name = $('name');
  const update = $('update');
  const note = $('note');
  const toggle = $('toggle');
  const stage = $('stage');
  const drop = $('drop');

  let mode: Mode = 'flat';
  let sheet: Sheet | null = null;
  let viewer: { destroy(): void } | null = null;
  // Counts uploads, decided when each starts: a slow decode that finishes after a newer file was
  // chosen sees it's out of date and drops its result.
  let generation = 0;

  function unmount() {
    viewer?.destroy();
    viewer = null;
  }

  function mount() {
    unmount();
    if (sheet) viewer = createView(stage, mode, sheet);
  }

  function say(text: string) {
    note.textContent = text;
    note.hidden = !text;
  }

  /** Shows `file` in `view`: the sample opens flat, your own files in flick. */
  async function load(file: File, view: Mode) {
    const mine = ++generation;
    let next: Sheet;
    try {
      next = await slice(file);
    } catch {
      if (mine === generation) say(`Couldn't read ${file.name} as an image.`);
      return;
    }
    if (mine !== generation) return next.dispose();

    unmount();
    sheet?.dispose();
    sheet = next;
    mode = view;
    toggleTo(mode);
    name.textContent = name.title = file.name;
    update.hidden = toggle.hidden = false;
    say(isSheetShaped(next.width, next.height) ? '' : 'Not A-series landscape: pages will be stretched');
    mount();
  }

  input.addEventListener('change', () => {
    const file = input.files?.[0];
    // Cleared so choosing the same file again still counts as a change.
    input.value = '';
    if (file) load(file, 'flick');
  });
  update.addEventListener('click', () => input.click());
  const toggleTo = bindToggle(toggle, mode, (next) => {
    mode = next;
    mount();
  });
  fetch(sample)
    .then((r) => r.blob())
    .then((blob) => load(new File([blob], 'sample.png', { type: blob.type }), 'flat'));
  // Dropping a file works anywhere, at any time. dragenter and dragleave also fire for the page's
  // children, so a counter tells when the drag has really left.
  let dragging = 0;
  const hasFiles = (e: DragEvent) => !!e.dataTransfer?.types.includes('Files');
  const setDragging = (n: number) => {
    dragging = n;
    drop.hidden = n === 0;
  };
  addEventListener('dragenter', (e) => hasFiles(e) && setDragging(dragging + 1));
  addEventListener('dragleave', (e) => hasFiles(e) && setDragging(Math.max(0, dragging - 1)));
  // Cancelling dragover is what allows a drop, and stops the browser opening the file instead.
  addEventListener('dragover', (e) => e.preventDefault());
  addEventListener('drop', (e) => {
    e.preventDefault();
    setDragging(0);
    const file = e.dataTransfer?.files[0];
    if (file) load(file, 'flick');
  });
</script>

<style>
  main { height: 100dvh; display: grid; grid-template-rows: auto 1fr; }
  /* The name gives way before (update) does. */
  .title { display: flex; align-items: baseline; min-width: 0; }
  .name { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .update { flex: none; margin-left: 6px; padding: 0; border: 0; background: none; color: var(--ink-dim); font: inherit; font-weight: 400; text-decoration: underline; cursor: pointer; }
  .update:hover { color: var(--ink); }
  .update[hidden] { display: none; }
  .update:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }

  .stage { position: relative; min-height: 0; background: var(--viewer); }
  .note { position: absolute; z-index: 1; top: 8px; left: 16px; right: 16px; margin: 0; font-size: 13px; color: var(--ink-dim); }
  .note[hidden] { display: none; }
  .drop {
    position: fixed; inset: 8px; z-index: 4; display: grid; place-items: center; pointer-events: none;
    border: 2px dashed var(--ink); background: color-mix(in srgb, var(--paper) 85%, transparent);
  }
  .drop[hidden] { display: none; }
</style>
