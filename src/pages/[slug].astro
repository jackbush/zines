---
// One zine: the top bar (back to the library, the name and, if the manifest has a `buy` link,
// "Buy a copy"), then the flick reader in the zine's own colour.
import BaseLayout from '../layouts/BaseLayout.astro';
import TopBar from '../components/TopBar.astro';
import { site } from '../lib/site';
import type { Sources } from '../lib/views';
import { getZines, type ZineEntry } from '../lib/zines';

export function getStaticPaths() {
  return getZines().map((zine) => ({ params: { slug: zine.slug }, props: { zine } }));
}

const { zine } = Astro.props as { zine: ZineEntry };
const sources: Sources = { pages: zine.pages, sheet: zine.sheet };
---

<BaseLayout title={`${zine.name} | ${site.name}`} appTitle={zine.name}>
  <main>
    <TopBar>
      {zine.name}
      {zine.buy && <a class="buy" href={zine.buy} rel="noopener" slot="actions">Buy a copy</a>}
    </TopBar>
    <div class="stage" id="stage" role="region" aria-label={zine.name} style={`background:${zine.background}`} data-sources={JSON.stringify(sources)}></div>
  </main>
</BaseLayout>

<script>
  import { createView, type Sources } from '../lib/views';

  const stage = document.getElementById('stage')!;
  createView(stage, 'flick', JSON.parse(stage.dataset.sources!) as Sources, { labels: false });
</script>

<style>
  main { height: 100dvh; display: grid; grid-template-rows: auto 1fr; }
  .stage { position: relative; min-height: 0; }
  .buy {
    height: 32px; padding: 0 12px; display: inline-flex; align-items: center; white-space: nowrap;
    border: 1px solid var(--line); background: #fff; color: var(--ink); font-size: 14px; text-decoration: none;
  }
  .buy:hover { background: var(--hover); }
  .buy:focus-visible { outline: 2px solid var(--line); outline-offset: 2px; }
</style>
