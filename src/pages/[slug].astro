---
// One zine: the top bar (back to the library, the name, and "Download" and "Buy a copy" when the
// manifest offers them), then the flick reader in the zine's own colour.
import BaseLayout from '../layouts/BaseLayout.astro';
import TopBar from '../components/TopBar.astro';
import { site } from '../lib/site';
import type { Sources } from '../lib/views';
import { getZines, type ZineEntry } from '../lib/zines';

export function getStaticPaths() {
  return getZines().map((zine) => ({ params: { slug: zine.slug }, props: { zine } }));
}

const { zine } = Astro.props as { zine: ZineEntry };
const sources: Sources = { pages: zine.pages, sheet: zine.sheet };
---

<BaseLayout title={`${zine.name} | ${site.name}`} appTitle={zine.name}>
  <main>
    <TopBar>
      {zine.name}
      {/* A lone button is filled; with both, Buy is the filled one, on the right. */}
      {zine.downloadUrl && <a class:list={['btn', { 'btn-fill': !zine.buy }]} href={zine.downloadUrl} download={`${zine.slug}.png`} slot="actions">Download</a>}
      {zine.buy && <a class="btn btn-fill" href={zine.buy} rel="noopener" slot="actions">Buy a copy</a>}
    </TopBar>
    <div class="stage" id="stage" role="region" aria-label={zine.name} style={zine.background && `background:${zine.background}`} data-sources={JSON.stringify(sources)}></div>
  </main>
</BaseLayout>

<script>
  import { createView, type Sources } from '../lib/views';

  const stage = document.getElementById('stage')!;
  createView(stage, 'flick', JSON.parse(stage.dataset.sources!) as Sources, { labels: false });
</script>

<style>
  main { height: 100dvh; display: grid; grid-template-rows: auto 1fr; }
  .stage { position: relative; min-height: 0; background: var(--viewer); }
</style>
