---
// One zine: the flick viewer, full screen, with a back button to the library and, if the
// manifest has a `buy` link, "Buy a copy".
import BaseLayout from '../layouts/BaseLayout.astro';
import Back from '../components/Back.astro';
import Flick from '../components/Flick.astro';
import { site } from '../lib/site';
import { getZines, type ZineEntry } from '../lib/zines';

export function getStaticPaths() {
  return getZines().map((zine) => ({ params: { slug: zine.slug }, props: { zine } }));
}

const { zine } = Astro.props as { zine: ZineEntry };
---

<BaseLayout title={`${zine.name} | ${site.name}`} appTitle={zine.name}>
  <Back />
  <main>
    <h1>{zine.name}</h1>
    <Flick pages={zine.pages} label={zine.name} />
    {zine.buy && <a class="buy" href={zine.buy} rel="noopener">Buy a copy</a>}
  </main>
</BaseLayout>

<style>
  main { height: 100dvh; display: grid; grid-template-rows: auto 1fr auto; }
  h1 { margin: 0; padding: max(14px, env(safe-area-inset-top)) 68px 0; min-height: 54px; display: flex; align-items: center; justify-content: center; font-size: 16px; font-weight: 600; }
  .buy {
    justify-self: center; margin: 0 0 max(16px, env(safe-area-inset-bottom));
    padding: 10px 18px; border: 1px solid var(--line); color: var(--ink); text-decoration: none;
  }
  .buy:hover, .buy:focus-visible { background: var(--ink); color: #fff; }
</style>
